rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──────────────────────────────────────────────────────────────────
    // Only the owning user may read or write their profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ── BMI History ────────────────────────────────────────────────────────────
    // Create: the new document must be tagged with the caller's uid.
    // Read / update: only the owner may access their records.
    // Delete: only the owner may delete their records.
    //
    // Note: update is required by SyncService when pushing a record that
    // already has a remoteId (previously synced and now modified locally).
    match /history/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      allow read, delete: if request.auth != null
                          && resource.data.userId == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
    }

    // ── Blood Pressure ─────────────────────────────────────────────────────────
    // Same ownership model as `history`. Create tags the doc with the caller's
    // uid; everything else is owner-only.
    match /blood_pressure/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      allow read, delete: if request.auth != null
                          && resource.data.userId == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
    }

    // ── Blood Sugar ───────────────────────────────────────────────────────────
    // Same ownership model as `history`.
    match /blood_sugar/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      allow read, delete: if request.auth != null
                          && resource.data.userId == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
    }
  }
}
